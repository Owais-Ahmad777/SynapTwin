# SynapTwin backend env template — copy to `.env` and fill in.
# `.env` is git-ignored (see root .gitignore). Never commit real keys.
# On Render.com, set these same keys as Environment Variables instead
# (render.yaml already declares GEMINI_API_KEY + FERNET_SECRET_KEY with sync:false).

# Optional: Google Gemini API key for live explainability + alerts.
# Get one at https://aistudio.google.com/app/apikey
# If empty/missing, backend automatically uses deterministic offline explainer.
GEMINI_API_KEY=

# Optional but RECOMMENDED: persistent Fernet key for privacy vault.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, server generates one process-stable key at startup (data won't
# survive restarts, and multi-worker deploys will disagree).
FERNET_SECRET_KEY=

# Local dev port (Render injects $PORT automatically in production).
PORT=5000

# Optional overrides
# STATIC_FOLDER=
# OPEN_METEO_TIMEOUT_SEC=4
# OPEN_METEO_CACHE_TTL_HOURS=6
# Per-hour live LLM OFF by default (avoids 48 Gemini calls/request timeout).
# ENABLE_LIVE_LLM_PER_HOUR=false
# Simulation cache TTL seconds (5-min default avoids re-running 24h sim).
# SIM_CACHE_TTL_SEC=300
# CORS allowlist, comma-separated ("*" = open demo mode).
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://synaptwin.onrender.com
# Optional API-key auth: if set, sim/privacy/audit need X-API-Key or ?api_key=.
# API_KEY=
# Rate limit sim requests per IP per minute (0 = disabled).
# RATE_LIMIT_PER_MINUTE=120
